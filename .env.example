# ─── Supabase (Project Settings → API) ───
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Ignora o RLS: usado pelo worker, webhooks e para ler credenciais.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Segurança ───
# Chave mestra que cifra as credenciais das organizações (32 bytes em base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder esta chave = recadastrar todas as conexões. Guarde num cofre.
CHAVE_CIFRAGEM=
# Segredo que o Supabase (pg_cron) manda ao chamar /api/jobs/processar. Mesmo valor do segredo
# "worker_segredo" no Vault. Gere com o mesmo comando acima.
SEGREDO_WORKER=

# Endereço público do sistema (links de convite, teste de rastreio). Ex.: https://ads.seudominio.com.br
URL_SISTEMA=http://localhost:3000

# ─── Meta ───
META_API_VERSION=v26.0
